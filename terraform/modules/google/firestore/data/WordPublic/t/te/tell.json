                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "**Tell** me about your day at school."
                                      }
                                    }
                                  }
                                },
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "She **tells** enchanting stories day and night."
                                      }
                                    }
                                  }
                                },
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "The newspaper **tells** his story well."
