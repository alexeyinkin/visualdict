                      "mapValue": {
                        "fields": {
                          "complexDefinition": {
                            "stringValue": "Used to indicate that a desired or adequate amount, extent or degree has been reached."
                          },
                          "definition": {
                            "stringValue": "Showing that you want no more of something."
                          },
                          "definitionTranslations": {
