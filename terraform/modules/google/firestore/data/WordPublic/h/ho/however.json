                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "Указывает на \"несмотря на это\"."
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "usages": {
                            "arrayValue": {
                              "values": [
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "He was hungry, **however** he didn't eat."
                                      }
                                    }
                                  }
                                },
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "She wanted to leave; **however**, he insisted they stay."
                                      }
                                    }
                                  }
                                },
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "They planned a vacation; **however**, they had no time."
                                      }
                                    }
                                  }
                                }
                              ]
                            }
                          }
