              "senses": {
                "arrayValue": {
                  "values": [
                    {
                      "mapValue": {
                        "fields": {
                          "complexDefinition": {
                            "stringValue": "Used to introduce a statement that contrasts with or seems to contradict something that has been said previously."
                          },
                          "definition": {
                            "stringValue": "Introduces a contrasting statement."
                          },
                          "definitionTranslations": {
                            "mapValue": {
                              "fields": {
                                "ru": {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "Вводит противоположное утверждение."
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "usages": {
                            "arrayValue": {
                              "values": [
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "**However**, dogs are not allowed in this restaurant."
                                      }
                                    }
                                  }
                                },
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "She studied hard. **However**, she failed the exam."
                                      }
                                    }
                                  }
                                },
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "He loves sports. **However**, he's not good at baseball."
                                      }
                                    }
                                  }
                                }
                              ]
                            }
                          }
                        }
                      }
                    },
                    {
                      "mapValue": {
                        "fields": {
                          "complexDefinition": {
                            "stringValue": "In whatever way; regardless of how."
                          },
                          "definition": {
                            "stringValue": "Means \"in whatever way\"."
                          },
                          "definitionTranslations": {
                            "mapValue": {
                              "fields": {
                                "ru": {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "Значит \"любым способом\"."
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "usages": {
                            "arrayValue": {
                              "values": [
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "**However** you want to do it, it's fine by me."
                                      }
                                    }
                                  }
                                },
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "We can improve this situation, **however** hard it may seem."
                                      }
                                    }
                                  }
                                },
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "You have to finish your task, **however** long it takes."
                                      }
                                    }
                                  }
                                }
                              ]
                            }
                          }
                        }
                      }
                    },
                    {
                      "mapValue": {
                        "fields": {
                          "complexDefinition": {
                            "stringValue": "To whatever extent or degree."
                          },
                          "definition": {
                            "stringValue": "Indicates \"to whatever degree\"."
                          },
                          "definitionTranslations": {
                            "mapValue": {
                              "fields": {
                                "ru": {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "Обозначает \"в какой бы степени\"."
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "usages": {
                            "arrayValue": {
                              "values": [
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "**However** much you study, success isn't guaranteed."
                                      }
                                    }
                                  }
                                },
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "**However** fast you run, someone is always faster."
                                      }
                                    }
                                  }
                                },
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "Eat **however** much you want, it's a feast."
                                      }
                                    }
                                  }
                                }
                              ]
                            }
                          }
                        }
                      }
                    },
                    {
                      "mapValue": {
                        "fields": {
                          "complexDefinition": {
                            "stringValue": "No matter how."
                          },
                          "definition": {
                            "stringValue": "Means \"no matter how\"."
                          },
                          "definitionTranslations": {
                            "mapValue": {
                              "fields": {
                                "ru": {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "Означает \"независимо от того, как\"."
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "usages": {
                            "arrayValue": {
                              "values": [
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "**However** hard you work, you won't finish on time."
                                      }
                                    }
                                  }
                                },
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "She'll win the race, **however** fast her opponents are."
                                      }
                                    }
                                  }
                                },
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "**However** clever you are, there's always someone smarter."
                                      }
                                    }
                                  }
                                }
                              ]
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "mapValue": {
            "fields": {
              "partOfSpeech": {
                "stringValue": "conjunction"
              },
              "senses": {
                "arrayValue": {
                  "values": [
                    {
                      "mapValue": {
                        "fields": {
                          "complexDefinition": {
                            "stringValue": "But; on the other hand."
                          },
                          "definition": {
                            "stringValue": "Means \"but\" or \"yet\"."
                          },
                          "definitionTranslations": {
                            "mapValue": {
                              "fields": {
                                "ru": {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "Значит \"но\" или \"однако\"."
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "usages": {
                            "arrayValue": {
                              "values": [
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "**However**, she still decided to go for a run."
                                      }
                                    }
                                  }
                                },
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "I was tired. **However**, I finished the entire project."
                                      }
                                    }
                                  }
                                },
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "He failed his test, **however**, he did not give up."
                                      }
                                    }
                                  }
                                }
                              ]
                            }
                          }
                        }
                      }
                    },
                    {
                      "mapValue": {
                        "fields": {
                          "complexDefinition": {
                            "stringValue": "Nevertheless; yet; on the other hand; in spite of that. "
                          },
                          "definition": {
                            "stringValue": "Indicates “despite that”."
                          },
                          "definitionTranslations": {
