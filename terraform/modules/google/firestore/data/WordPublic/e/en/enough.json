                                }
                              }
                            }
                          },
                          "usages": {
                            "arrayValue": {
                              "values": [
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "**Enough**, I can't stand any more brussel sprouts!"
                                      }
                                    }
                                  }
                                },
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "Everybody quiet **enough** with the noise!"
                                      }
                                    }
                                  }
                                },
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "Please, **enough**, I've had too much coffee today!"
                                      }
                                    }
                                  }
                                }
                              ]
                            }
                          }
