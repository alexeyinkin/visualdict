                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "**Tell** the difference between a cat and a dog."
                                      }
                                    }
                                  }
                                },
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "She could **tell** it was a lie by his expression."
                                      }
                                    }
                                  }
                                },
                                {
                                  "mapValue": {
                                    "fields": {
                                      "text": {
                                        "stringValue": "Could you **tell** where that sound came from?"
                                      }
                                    }
                                  }
                                }
